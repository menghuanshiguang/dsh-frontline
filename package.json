{
  "name": "@local/dsh-frontline",
  "version": "1.0.0",
  "private": true,
  "description": "同一个模型，装与不装是两种交付质量。一条提示词行把模型的自我要求写进每一次请求：身份锁死不被推翻，交付前必须证明而不是声称，答复短到能读完。零依赖，不发网络请求，不碰文件。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./identity": "./src/identity.js",
    "./discipline": "./src/discipline.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menghuanshiguang/dsh-frontline.git"
  },
  "scripts": {
    "test": "node test/smoke.mjs && node test/contract.mjs && node test/integration.mjs && node test/lifecycle.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:contract": "node test/contract.mjs",
    "test:integration": "node test/integration.mjs",
    "test:lifecycle": "node test/lifecycle.mjs",
    "audit": "node test/audit.mjs"
  },
  "files": [
    "index.js",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "test"
  ],
  "engines": {
    "node": ">=18"
  }
}
